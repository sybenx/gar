<?xml version="1.0" encoding="utf-8"?>
<!-- GAR: merged into the app manifest. Lets the user pick GAR as the digital assistant app, see
     gar/assist/README.md. Both services are bound only by the system (BIND_VOICE_INTERACTION). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <service
            android:name="cc.aaro.gar.assist.GarVoiceInteractionService"
            android:exported="true"
            android:label="@string/gar_assist_label"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/gar_voice_interaction_service" />
        </service>

        <service
            android:name="cc.aaro.gar.assist.GarVoiceInteractionSessionService"
            android:exported="true"
            android:label="@string/gar_assist_label"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
    </application>
</manifest>
