root ::= <tool_call> "\n" ( set-alarm | set-timer | cancel-alarm | send-sms | call-contact | open-app | set-volume | set-reminder | create-event | get-date | toggle-flashlight | identify-song | get-time | media-control | cancel-timer | calculate ) "\n" </tool_call>
set-alarm ::= "{\"name\": \"set_alarm\", \"arguments\": {" ( ( "\"time\": " jstr ) | ( "\"time\": " jstr ", " "\"label\": " jstr ) ) "}}"
set-timer ::= "{\"name\": \"set_timer\", \"arguments\": {" ( ( "\"duration\": " jstr ) ) "}}"
cancel-alarm ::= "{\"name\": \"cancel_alarm\", \"arguments\": {" ( ( "" ) | ( "\"time\": " jstr ) ) "}}"
send-sms ::= "{\"name\": \"send_sms\", \"arguments\": {" ( ( "\"contact\": " jstr ", " "\"message\": " jstr ) ) "}}"
call-contact ::= "{\"name\": \"call_contact\", \"arguments\": {" ( ( "\"contact\": " jstr ) ) "}}"
open-app ::= "{\"name\": \"open_app\", \"arguments\": {" ( ( "\"app\": " jstr ) ) "}}"
set-volume ::= "{\"name\": \"set_volume\", \"arguments\": {" ( ( "" ) | ( "\"direction\": " ( "\"up\"" | "\"down\"" | "\"mute\"" ) ) | ( "\"level\": " jstr ) | ( "\"direction\": " ( "\"up\"" | "\"down\"" | "\"mute\"" ) ", " "\"level\": " jstr ) ) "}}"
set-reminder ::= "{\"name\": \"set_reminder\", \"arguments\": {" ( ( "\"what\": " jstr ", " "\"when\": " jstr ) ) "}}"
create-event ::= "{\"name\": \"create_event\", \"arguments\": {" ( ( "\"title\": " jstr ", " "\"when\": " jstr ) ) "}}"
get-date ::= "{\"name\": \"get_date\", \"arguments\": {" ( ( "" ) ) "}}"
toggle-flashlight ::= "{\"name\": \"toggle_flashlight\", \"arguments\": {" ( ( "\"state\": " ( "\"on\"" | "\"off\"" ) ) ) "}}"
identify-song ::= "{\"name\": \"identify_song\", \"arguments\": {" ( ( "" ) ) "}}"
get-time ::= "{\"name\": \"get_time\", \"arguments\": {" ( ( "" ) ) "}}"
media-control ::= "{\"name\": \"media_control\", \"arguments\": {" ( ( "\"action\": " ( "\"play\"" | "\"pause\"" | "\"next\"" | "\"previous\"" ) ) ) "}}"
cancel-timer ::= "{\"name\": \"cancel_timer\", \"arguments\": {" ( ( "" ) | ( "\"name\": " jstr ) ) "}}"
calculate ::= "{\"name\": \"calculate\", \"arguments\": {" ( ( "\"expression\": " jstr ) ) "}}"
jstr ::= "\"" [^"\\\n]+ "\""