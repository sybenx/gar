root ::= <start_function_call> "call:" ( set-alarm | set-timer | cancel-alarm | send-sms | call-contact | open-app | set-volume | set-reminder | create-event | get-date | toggle-flashlight | identify-song | get-time | media-control | cancel-timer | calculate ) <end_function_call>
set-alarm ::= "set_alarm{" ( ( "time:" str ) | ( "label:" str "," "time:" str ) ) "}"
set-timer ::= "set_timer{" ( ( "duration:" str ) ) "}"
cancel-alarm ::= "cancel_alarm{" ( ( "" ) | ( "time:" str ) ) "}"
send-sms ::= "send_sms{" ( ( "contact:" str "," "message:" str ) ) "}"
call-contact ::= "call_contact{" ( ( "contact:" str ) ) "}"
open-app ::= "open_app{" ( ( "app:" str ) ) "}"
set-volume ::= "set_volume{" ( ( "" ) | ( "direction:" <escape> ("up" | "down" | "mute") <escape> ) | ( "level:" str ) | ( "direction:" <escape> ("up" | "down" | "mute") <escape> "," "level:" str ) ) "}"
set-reminder ::= "set_reminder{" ( ( "what:" str "," "when:" str ) ) "}"
create-event ::= "create_event{" ( ( "title:" str "," "when:" str ) ) "}"
get-date ::= "get_date{" ( ( "" ) ) "}"
toggle-flashlight ::= "toggle_flashlight{" ( ( "state:" <escape> ("on" | "off") <escape> ) ) "}"
identify-song ::= "identify_song{" ( ( "" ) ) "}"
get-time ::= "get_time{" ( ( "" ) ) "}"
media-control ::= "media_control{" ( ( "action:" <escape> ("play" | "pause" | "next" | "previous") <escape> ) ) "}"
cancel-timer ::= "cancel_timer{" ( ( "" ) | ( "name:" str ) ) "}"
calculate ::= "calculate{" ( ( "expression:" str ) ) "}"
str ::= <escape> [^<]+ <escape>