root ::= <tool_call> "\n" ( call-timer-set | call-timer-cancel | call-timer-query | call-call-contact | call-open-app | call-media-control | call-flashlight | call-current-time | call-navigate | call-calculate | call-read-notifications | call-wake-word | call-alarm-set | call-sms-send | call-no-match ) "\n" </tool_call>
call-timer-set ::= "{\"name\": \"timer_set\", \"arguments\": {" "\"duration\": " "\"" span "\"" ( ", " "\"name\": " "\"" span "\"" )? "}}"
call-timer-cancel ::= "{\"name\": \"timer_cancel\", \"arguments\": {" ( "\"name\": " "\"" span "\"" )? "}}"
call-timer-query ::= "{\"name\": \"timer_query\", \"arguments\": {" ( "\"name\": " "\"" span "\"" )? "}}"
call-call-contact ::= "{\"name\": \"call_contact\", \"arguments\": {" "\"who\": " "\"" span "\"" "}}"
call-open-app ::= "{\"name\": \"open_app\", \"arguments\": {" "\"what\": " "\"" span "\"" "}}"
call-media-control ::= "{\"name\": \"media_control\", \"arguments\": {" "\"action\": " ( "\"play\"" | "\"pause\"" | "\"next\"" | "\"previous\"" ) "}}"
call-flashlight ::= "{\"name\": \"flashlight\", \"arguments\": {" "\"state\": " ( "\"on\"" | "\"off\"" ) "}}"
call-current-time ::= "{\"name\": \"current_time\", \"arguments\": {}}"
call-navigate ::= "{\"name\": \"navigate\", \"arguments\": {" "\"where\": " "\"" span "\"" "}}"
call-calculate ::= "{\"name\": \"calculate\", \"arguments\": {" "\"calculation\": " "\"" span "\"" "}}"
call-read-notifications ::= "{\"name\": \"read_notifications\", \"arguments\": {}}"
call-wake-word ::= "{\"name\": \"wake_word\", \"arguments\": {" "\"state\": " ( "\"on\"" | "\"off\"" ) "}}"
call-alarm-set ::= "{\"name\": \"alarm_set\", \"arguments\": {" "\"time\": " "\"" span "\"" ( ", " "\"label\": " "\"" span "\"" )? "}}"
call-sms-send ::= "{\"name\": \"sms_send\", \"arguments\": {" "\"to\": " "\"" span "\"" ", " "\"message\": " "\"" span "\"" "}}"
call-no-match ::= "{\"name\": \"no_match\", \"arguments\": {}}"
span ::= s-1 | s-2 | s-3 | s-4
s-1 ::= "open" ( " " s-2 )?
s-2 ::= "spot" ( " " s-3 )?
s-3 ::= "if" ( " " s-4 )?
s-4 ::= "i"
