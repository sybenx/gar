root ::= <start_function_call> "call:" ( call-timer-set | call-timer-cancel | call-timer-query | call-call-contact | call-open-app | call-media-control | call-flashlight | call-current-time | call-navigate | call-calculate | call-read-notifications | call-wake-word | call-alarm-set | call-sms-send | call-no-match ) <end_function_call>
call-timer-set ::= "timer_set{" "duration:" <escape> span <escape> ( "," "name:" <escape> span <escape> )? "}"
call-timer-cancel ::= "timer_cancel{" ( "name:" <escape> span <escape> )? "}"
call-timer-query ::= "timer_query{" ( "name:" <escape> span <escape> )? "}"
call-call-contact ::= "call_contact{" "who:" <escape> span <escape> "}"
call-open-app ::= "open_app{" "what:" <escape> span <escape> "}"
call-media-control ::= "media_control{" "action:" <escape> ( "play" | "pause" | "next" | "previous" ) <escape> "}"
call-flashlight ::= "flashlight{" "state:" <escape> ( "on" | "off" ) <escape> "}"
call-current-time ::= "current_time{}"
call-navigate ::= "navigate{" "where:" <escape> span <escape> "}"
call-calculate ::= "calculate{" "calculation:" <escape> span <escape> "}"
call-read-notifications ::= "read_notifications{}"
call-wake-word ::= "wake_word{" "state:" <escape> ( "on" | "off" ) <escape> "}"
call-alarm-set ::= "alarm_set{" ( "label:" <escape> span <escape> "," "time:" <escape> span <escape> | "time:" <escape> span <escape> ) "}"
call-sms-send ::= "sms_send{" "message:" <escape> span <escape> "," "to:" <escape> span <escape> "}"
call-no-match ::= "no_match{}"
span ::= s-1 | s-2 | s-3 | s-4
s-1 ::= "open" ( " " s-2 )?
s-2 ::= "spot" ( " " s-3 )?
s-3 ::= "if" ( " " s-4 )?
s-4 ::= "i"
