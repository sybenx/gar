    <!-- "Which city are you in?": asked once, when GAR doesn't know where the user is -->
    <string name="gar_weather_ask_place">Which city are you in? You can also say: use my location.</string>
    <string name="gar_weather_ask_place_no_permission">I can\'t read your location. Which city are you in? Or say: use my location.</string>
