<?xml version="1.0" encoding="utf-8"?>
<!-- GAR: the Tide glyph, a speech bubble with a voice wave, on the adaptive icon's 108 grid. The
     group scales it to 0.72 so the glyph is about as big as other apps' (at 0.9 it filled most
     of the circle; at full size it left the 66 dp safe circle). Also the drawer logo; themed
     icons use the smaller copy in ic_launcher_monochrome.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.72"
        android:scaleY="0.72"
        android:translateY="0.4">
        <path
            android:pathData="M32 34 h44 a8 8 0 0 1 8 8 v22 a8 8 0 0 1 -8 8 h-26 l-12 10 v-10 h-6 a8 8 0 0 1 -8 -8 v-22 a8 8 0 0 1 8 -8 z"
            android:strokeColor="#A7F3D0"
            android:strokeWidth="5"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M42 50 v6 M50 45 v16 M58 42 v22 M66 48 v10"
            android:strokeColor="#A7F3D0"
            android:strokeWidth="5"
            android:strokeLineCap="round" />
    </group>
</vector>
